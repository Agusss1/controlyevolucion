# CYO en Apache (p. ej. Hostinger): sitio estático, el juego corre en el navegador.
DirectoryIndex index.html
AddType application/javascript .js .mjs
AddType application/octet-stream .bin
<IfModule mod_headers.c>
  # la página principal no se guarda en caché para que las actualizaciones lleguen enseguida
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # los archivos con huella (assets/*) pueden guardarse mucho tiempo
  <FilesMatch "\.(js|css|png|svg|bin)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
